#!/usr/bin/env python3

import os
import shutil
from pathlib import Path

def copy_files_with_audio_replacement(source_dir, target_dir):
    """
    Копирует файлы из source_dir в target_dir, заменяя аудиофайлы пустыми txt-файлами
    
    Args:
        source_dir (str): Исходная директория
        target_dir (str): Целевая директория
    """

    if os.path.isdir(target_dir):
        shutil.rmtree(target_dir)
    
    # Создаем целевую директорию, если она не существует
    Path(target_dir).mkdir(parents=True, exist_ok=True)
    
    # Расширения аудиофайлов, которые нужно заменить
    audio_extensions = {'.flac', '.mp3', '.dsf', '.dff', '.wv', '.ape', '.m4a'}
    
    try:
        # Проходим по всем файлам и поддиректориям в исходной директории
        for root, dirs, files in os.walk(source_dir):
            # Определяем относительный путь для сохранения структуры директорий
            relative_path = os.path.relpath(root, source_dir)
            target_subdir = os.path.join(target_dir, relative_path)
            
            # Пропускаем саму исходную директорию (она будет представлена как '.')
            if relative_path != '.':
                Path(target_subdir).mkdir(parents=True, exist_ok=True)
            
            # Обрабатываем каждый файл
            for file in files:
                source_file_path = os.path.join(root, file)
                target_file_path = os.path.join(target_subdir, file)
                
                # Получаем расширение файла
                file_extension = Path(file).suffix
                
                # Проверяем, является ли файл аудиофайлом
                if file_extension in audio_extensions:
                    # Создаем txt-файл вместо аудиофайла
                    txt_filename = file + '.txt'
                    txt_file_path = os.path.join(target_subdir, txt_filename)
                    
                    # Создаем пустой txt-файл
                    with open(txt_file_path, 'w', encoding='utf-8') as f:
                        f.write("")
                        # f.write(f"# Этот файл заменяет аудиофайл: {file}\n")
                        # f.write(f"# Оригинальный путь: {source_file_path}\n")
                    
                    #print(f"Создан txt-файл: {txt_file_path} (вместо {file})")
                
                # else:
                    # Копируем обычный файл
                    # shutil.copy2(source_file_path, target_file_path)
                    # print(f"Скопирован файл: {target_file_path}")
    
    except Exception as e:
        print(f"Произошла ошибка: {e}")

def main():
    # Запрос путей у пользователя
    source_dir = "/media/dima/wd160/Music"
    target_dir = "/media/dima/wd160/MusicTxt"
    
    # Проверяем существование исходной директории
    if not os.path.exists(source_dir):
        print(f"Ошибка: Исходная директория '{source_dir}' не существует!")
        return
    
    copy_files_with_audio_replacement(source_dir, target_dir)


# Альтернативная версия с жестко заданными путями (раскомментируйте для использования)
# def main():
#     source_dir = "/путь/к/исходной/директории"
#     target_dir = "/путь/к/целевой/директории"
#     copy_files_with_audio_replacement(source_dir, target_dir)

if __name__ == "__main__":
    main()