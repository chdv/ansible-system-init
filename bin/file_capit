#!/usr/bin/env python3

import os

wdir=os.getcwd()

media=('flac','dsf', 'mp3')
 
for file in os.listdir(wdir):     
    if not file.endswith(media): continue   
    print(file)
    for i, c in enumerate(file):
        if c.isalpha():
            break
    fname=file[:i] + file[i:].capitalize()
    print(fname)
    os.rename(wdir + '/' + file, wdir + '/' + fname)
