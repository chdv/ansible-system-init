#!/bin/bash

album=`basename "$PWD"`

if [[ ${#album} -lt 10 ]]; then
	par=`dirname "$PWD"`
	album=`basename "$par"`
fi

arrAlbum=(${album// - / })

artist=${arrAlbum[0]}

if [ -n "$1" ]; then
  artist=$1
fi

i=2
albumStr=${arrAlbum[1]}
while [ $i -lt ${#arrAlbum[@]} ]; do
    albumStr="$albumStr ${arrAlbum[i]}"
	i=$((i+1))
done

album=$albumStr

genre='Classical'

if [ -n "$2" ]; then
  genre=$2
fi

echo $album
i=1
for file in *.flac; do	
	title=$(basename "$file" .flac)
	title="${title:5}"
	echo "ALBUM=$album TITLE=$title TRACKNUMBER=$i ARTIST=$artist GENRE=$genre"
	metaflac --remove-all "$file"
	metaflac --set-tag="COMPOSER=$artist" --set-tag="ARTIST=$artist" --set-tag="GENRE=$genre" --set-tag="ALBUM=$album" --set-tag="TITLE=$title" --set-tag="TRACKNUMBER=$i" "$file"	
	i=$((i+1))
done
#mpc update
#metaflac --list *.flac