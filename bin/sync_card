#!/bin/bash

# 1Tb Sandisk Red
CARD1_PATH="/media/dima/Red1Tb"
# 512Gb Phone Samsung Blue
CARD2_PATH="/media/dima/Blue512Gb"
# 512Gb Samsung Red
CARD3_PATH="/media/dima/Red512Gb"

MUSIC_PATH="/media/dima/wd160/Music"

if [ "$1" = "-u" ]; then
	if [ -e $CARD1_PATH ]; then
		umount $CARD1_PATH
	elif [ -e $CARD2_PATH ]; then
		umount $CARD2_PATH
	elif [ -e $CARD3_PATH ]; then
		umount $CARD3_PATH	
	fi
	exit 0
fi

if [ -e $CARD1_PATH ]; then
	CARD_PATH=$CARD1_PATH
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/New/ $CARD_PATH/PCM16/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM24/New/ $CARD_PATH/PCM24/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/DSD64/New/ $CARD_PATH/DSD64/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/DSD/New/ $CARD_PATH/DSD/New/	

	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/ $CARD_PATH/PCM16/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM24/Symphonic/ $CARD_PATH/PCM24/Symphonic/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM24/Soundtrack/ $CARD_PATH/PCM24/Soundtrack/
	echo
	df -h $CARD_PATH
elif [ -e $CARD2_PATH ]; then	
	CARD_PATH=$CARD2_PATH
#	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM24/ $CARD_PATH/PCM24/ --exclude='/Composers' --exclude='/New' 
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/New/ $CARD_PATH/PCM16/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM24/New/ $CARD_PATH/PCM24/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/DSD64/New/ $CARD_PATH/DSD64/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/DSD/New/ $CARD_PATH/DSD/New/	

	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/Symphonic\ pop/ $CARD_PATH/PCM16/Symphonic\ pop/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/Jazz/ $CARD_PATH/PCM16/Jazz/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/Soundtrack/ $CARD_PATH/PCM16/Soundtrack/
	echo
	df -h $CARD_PATH
elif [ -e $CARD3_PATH ]; then
	CARD_PATH=$CARD3_PATH
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/New/ $CARD_PATH/PCM16/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM24/New/ $CARD_PATH/PCM24/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/DSD64/New/ $CARD_PATH/DSD64/New/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/DSD/New/ $CARD_PATH/DSD/New/	

	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/Composers/ $CARD_PATH/PCM16/Composers/
	rsync -vtr --delete --progress --outbuf=N $MUSIC_PATH/PCM16/Symphonic/ $CARD_PATH/PCM16/Symphonic/
	echo
	df -h $CARD_PATH
fi

sync

echo	                   
echo '            ######   ####  #    # ###### '
echo '            #     # #    # ##   # #      '
echo '            #     # #    # # #  # #####  '
echo '            #     # #    # #  # # #      '
echo '            #     # #    # #   ## #      '
echo '            ######   ####  #    # ###### '