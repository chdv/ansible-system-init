#!/bin/bash

#cp -vru \!Аудио /media/dima/Red1Tb/Music1/Songs/\!Аудио

# PocoX3Pro
PHONE1_PATH="/run/user/1000/gvfs/mtp:host=Xiaomi_POCO_X3_Pro_168f2858/Внутренний общий накопитель"
# PocoF5
PHONE2_PATH="/run/user/1000/gvfs/mtp:host=Xiaomi_POCO_F5_f4f89e53/Внутренний общий накопитель"

MUSIC_PATH="/media/dima/wd160/Music/PCM16"
COPY_DIRS1=("Wind" "Piano" "Guitar" "Chamber" "Modern" "Choral" "Symphonic" "Flamenco" "Composers")
COPY_DIRS2=("Symphonic pop" "Jazz" "Soundtrack")
COPY_DIRS3=("New")

if [ -e "$PHONE1_PATH" ]; then
	PHONE_PATH=$PHONE1_PATH
	mkdir "$PHONE_PATH"/PCM16
	cd $MUSIC_PATH
	for DIR in "${COPY_DIRS1[@]}"; do
		echo `date +%T` Copying $(du -sh "$DIR")...
		cp -vru "$DIR" "$PHONE_PATH"/PCM16
	done
elif [ -e "$PHONE2_PATH" ]; then
	PHONE_PATH=$PHONE2_PATH
	mkdir "$PHONE_PATH"/PCM16
	cd $MUSIC_PATH
	for DIR in "${COPY_DIRS3[@]}"; do
		echo `date +%T` Copying $(du -sh "$DIR")...
		cp -vru "$DIR" "$PHONE_PATH"/PCM16
	done	
fi
echo `date +%T` Ending

echo	                   
echo '            ######   ####  #    # ###### '
echo '            #     # #    # ##   # #      '
echo '            #     # #    # # #  # #####  '
echo '            #     # #    # #  # # #      '
echo '            #     # #    # #   ## #      '
echo '            ######   ####  #    # ###### '
